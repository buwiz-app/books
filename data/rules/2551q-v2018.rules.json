  "mappings": [
    {
      "id": "2551Q.S1.1.base",
      "printed_item": "Schedule 1 row 1: taxable amount",
      "mode": "fill",
      "target_key": "txtATCAmt1",
      "measures": [
        "net_sales"
      ],
      "aggregation": "sum",
      "period_basis": "quarter",
      "person_scope": "taxpayer",
      "row": 1,
      "non_negative": true,
      "gates": [
        "GATE.PERIOD_LOCK",
        "GATE.RETURNS_ACK",
        "EXC.VAT_NOT_IN_SALES",
        "EXC.BANK_DEPOSIT_NOT_SALES",
        "EXC.PAYABLE_NOT_BASE",
        "EXC.SPOUSE_MVP",
        "REV.COUNT_ONCE",
        "REV.VOID_OPEN_PERIOD"
      ],
      "review": {
        "status": "open",
        "note": "Which sales measure feeds row 1 (net_sales or gross_sales) is a mapping rule for tax review (former D20, handed to Forms review). This rule set uses net_sales. The ATC on row 1 is chosen in Forms (drpATC1 is Forms-owned); the bridge fills the row-1 amount only. Whether a 2551Q is required for the period (8% year, NIL) is Forms' decision."
      },
      "poc": "implemented",
      "status": "PROPOSAL (key CONFIRMED: verify.md s4 item 23)",
      "citations": [
        "verify.md s4 (txtATCAmt1 accepted exact)",
        "bir.md PT-8 (returns treatment UNVERIFIED)",
        "docs/adr/0007-books-supplies-measures-forms-owns-compliance.md"
      ]
    },
    {
      "id": "2551Q.II.15",
      "printed_item": "15 Creditable percentage tax withheld per 2307",
      "mode": "fill",
      "target_key": "frm2551Qv2018:txt15",
      "measures": [
        "pt_withheld_2307_received"
      ],
      "aggregation": "sum",
      "period_basis": "certificate_period",
      "person_scope": "payor",
      "gates": [
        "GATE.PERIOD_LOCK",
        "GATE.CERT_STATUS",
        "EXC.IT_CWT_NOT_PT",
        "EXC.WB084_FINAL",
        "EXC.UNRECEIVED_CERT"
      ],
      "review": {
        "status": "settled",
        "note": "Percentage-tax certificates only. Whether the credit goes only to item 15 is INFERENCE (bir.md W-3), listed for tax review."
      },
      "poc": "implemented",
      "status": "CONFIRMED key; routing INFERENCE",
      "citations": [
        "verify.md s4 item 15 (creditable_tax_withheld)",
        "bir.md W-1 to W-4",
        "books.md s4g (status defect)"
      ]
    }
