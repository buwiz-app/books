    {
      "id": "1601C.II.15",
      "printed_item": "15 Statutory minimum wage for MWEs",
      "method": "payroll",
      "formula": "Minimum-wage earners only: basic pay at the statutory minimum wage. Needs the MWE flag.",
      "status": "CONFIRMED",
      "books_source": "payroll",
      "books_policy": "fill_p6",
      "citations": [
        "bir.md 3.4 (RR 11-2018 s2.78.1(B)(13); TRAIN s5 proviso)"
