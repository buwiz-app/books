    {
      "id": "1601C.II.16",
      "printed_item": "16 Holiday, overtime, night-shift and hazard pay (MWEs only)",
      "method": "payroll",
      "formula": "Qualified MWE components only. Holiday pay is exempt (TRAIN s5 proviso). Overtime, night-shift and hazard basis is UNVERIFIED.",
      "status": "CONFIRMED",
      "books_source": "payroll",
      "books_policy": "fill_p6",
      "status_detail": "Holiday pay CONFIRMED; overtime, night-shift and hazard legal basis UNVERIFIED (bir.md 3.4).",
      "citations": [
        "bir.md 3.4",
        "ra10963 line 63 (holiday pay)"
      ]
    },
    {
      "id": "1601C.II.17",
      "printed_item": "17 13th month pay and other benefits",
      "method": "payroll",
      "formula": "Exempt portion up to 90,000.00 per employee per calendar year. Cap is configurable: the Finance Secretary may raise it (bir.md 3.4).",
      "status": "CONFIRMED",
      "books_source": "payroll",
      "books_policy": "fill_p6",
      "test_vectors": [
        {
          "name": "synthetic: 95000.00 of 13th-month pay",
          "expected_exempt_text": "90000.00",
          "expected_taxable_excess_text": "5000.00"
        }
      ],
      "citations": [
        "NIRC s32(B)(7)(e) as amended by TRAIN s9 (bir.md 3.4; ra10963 lines 101-106)",
        "RR 11-2018 s2.78.1(B)(11)"
      ]
    },
    {
      "id": "1601C.II.18",
      "printed_item": "18 De minimis benefits",
      "method": "payroll",
      "formula": "Exempt portion by benefit type and ceiling. Verified ceilings: monetized unused vacation leave up to 10 days (private); medical cash allowance up to 1,500 per semester; rice subsidy up to 2,000 or 50 kg per month; uniforms up to 6,000 per year. Other types UNVERIFIED.",
      "status": "CONFIRMED",
      "books_source": "payroll",
      "books_policy": "fill_p6",
      "status_detail": "Ceilings (a)-(e) CONFIRMED in RR 11-2018 text; the rest UNVERIFIED (bir.md 3.4).",
      "citations": [
        "RR 11-2018 s2.78.1(3) (bir.md 3.4)"
      ]
    },
    {
      "id": "1601C.II.19",
      "printed_item": "19 SSS, GSIS, PHIC, HDMF contributions and union dues (employee share only)",
      "method": "payroll",
      "formula": "Employee shares only: SSS, PhilHealth, Pag-IBIG, GSIS if applicable, union dues. Never the employer share (EXC.EMPLOYER_SHARE_NOT_19). The payable account also holds the employer share, so do not use the full account balance.",
      "status": "CONFIRMED",
      "books_source": "payroll",
      "books_policy": "fill_p6",
      "gates": [
        "EXC.EMPLOYER_SHARE_NOT_19"
      ],
      "status_detail": "RR 11-2018 CONFIRMED; the statute text is UNVERIFIED. The crosswalk path /tax_19_sss_gsis is narrower than the label (verify.md s3b).",
      "test_vectors": [
        {
          "name": "BK-TS defect vector",
          "employee_share_text": "2000.00",
          "expected_II19_text": "2000.00"
        }
      ],
      "citations": [
        "RR 11-2018 s2.78.1(B)(12) (bir.md 3.4)",
        "verify.md s2 #69",
        "books.md s1 #1 (BK-TS drops the employee share)"
