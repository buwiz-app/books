    {
      "id": "1601C.II.17",
      "printed_item": "17 13th month pay and other benefits (non-taxable part)",
      "mode": "fill",
      "target_key": "frm1601c:txtTax17",
      "measures": [
        "thirteenth_month_and_benefits_paid"
      ],
      "aggregation": "nontaxable_13th_month_cap",
      "aggregation_params": {
        "annual_cap_text": "90000.00",
        "per": "employee (party_ref) per calendar year",
        "ytd_measure": "thirteenth_month_and_benefits_paid",
        "ytd_basis": "year_to_date_before_period",
        "formula": "per employee: min(paid in the month, max(0, cap - paid earlier in the year)); summed over employees"
      },
      "period_basis": "month",
      "person_scope": "employee",
      "gates": [
        "GATE.PERIOD_LOCK"
      ],
      "input_level_tax_rule": "THE ONE INPUT-LEVEL TAX RULE IN THE BRIDGE. Item 17 asks for the NON-TAXABLE part of 13th month pay and other benefits (annual cap 90,000.00 per employee). Only Books has the year-to-date payroll it needs. Open for the Forms owner: either Forms applies the cap (and the bridge sends the gross paid amount through a new input), or the bridge keeps it here. See research/handoff-to-forms/compliance-notes.md.",
      "review": {
        "status": "open",
        "note": "Gray area kept in the mapping layer by owner instruction (2026-10-29). The cap may be raised by the Finance Secretary (bir.md 3.4)."
      },
      "poc": "implemented",
      "status": "CONFIRMED key; cap CONFIRMED (NIRC s32(B)(7)(e) as amended)",
      "test_vectors": [
        {
          "name": "synthetic: 95000.00 paid, nothing earlier in the year",
          "expected_text": "90000.00"
        }
      ],
      "citations": [
        "NIRC s32(B)(7)(e) as amended by TRAIN s9 (bir.md 3.4; ra10963 lines 101-106)",
        "RR 11-2018 s2.78.1(B)(11)"
      ]
    },
