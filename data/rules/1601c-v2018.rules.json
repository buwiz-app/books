    {
      "id": "1601C.H.3",
      "printed_item": "3 Any taxes withheld?",
      "mode": "fill",
      "target_key": "frm1601c:TaxWithheld",
      "measures": [
        "tax_withheld_from_employees"
      ],
      "aggregation": "choice_yes_if_nonzero",
      "aggregation_params": {
        "yes": "1",
        "no": "2"
      },
      "period_basis": "month",
      "person_scope": "employee",
      "gates": [
        "GATE.PERIOD_LOCK"
      ],
      "review": {
        "status": "settled",
        "note": "A payroll fact: yes when payroll recorded any tax withheld in the month."
      },
      "poc": "implemented",
      "status": "CONFIRMED key",
      "citations": [
        "workbook 1601-C H.3",
        "verify.md s4 item 3"
      ]
    },
    {
