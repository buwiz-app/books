      "printed_item": "16 Holiday, overtime, night-shift and hazard pay (MWEs only)",
      "mode": "fill",
      "target_key": "frm1601c:txtTax16",
      "measures": [
        "holiday_ot_nsd_hazard_pay"
      ],
      "aggregation": "sum",
      "period_basis": "month",
      "person_scope": "employee",
      "gates": [
        "GATE.PERIOD_LOCK"
      ],
      "review": {
        "status": "open",
        "note": "Item 16 takes this pay for minimum-wage earners only. The per-employee MWE split of the measure is planned (P6)."
      },
      "poc": "fail_closed",
      "fail_closed_code": "mwe_split_not_implemented",
      "status": "CONFIRMED key",
      "citations": [
