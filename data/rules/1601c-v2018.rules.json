    {
      "id": "1601C.II.14",
      "printed_item": "14 Total amount of compensation",
      "method": "payroll",
      "formula": "Gross compensation per employee before employee deductions: basic gross plus exempt benefits. No employer-contribution expense. Reconcile to payroll detail.",
      "status": "CONFIRMED",
      "books_source": "payroll",
      "books_policy": "fill_p6",
      "test_vectors": [
        {
          "name": "synthetic: basic 40000.00 + de minimis 2000.00",
          "expected_text": "42000.00"
