  "rules": [
    {
      "id": "2551Q.H.1",
      "printed_item": "1 For the (calendar or fiscal)",
      "method": "profile",
      "formula": "Copy the tax-year basis from the BIR profile. Books never sends it.",
      "status": "CONFIRMED",
      "books_source": "profile",
      "books_policy": "never_fill",
      "citations": [
        "verify.md s4 item 1 (forThe -> /tax_period_basis)"
      ]
    },
    {
      "id": "2551Q.H.2",
      "printed_item": "2 Year ended (month and year)",
      "method": "profile+identity",
      "formula": "Year-end month comes from the profile. Taxable year comes from the requested period (identity lock).",
      "status": "CONFIRMED",
      "books_source": "profile",
      "books_policy": "never_fill",
      "citations": [
        "verify.md s4 item 2 (rtnMonth, txtYear identity)"
      ]
    },
    {
      "id": "2551Q.H.3",
      "printed_item": "3 Quarter",
      "method": "identity",
      "formula": "Forms sets the quarter from the requested filing period (calendar quarter). Books sends no quarter.",
      "status": "CONFIRMED",
      "books_source": "none",
      "books_policy": "never_fill",
      "citations": [
        "verify.md s4 item 3 (qtr radios derived or app-written)",
        "forms.md s4 (exact calendar quarter)"
      ]
    },
    {
      "id": "2551Q.H.4",
      "printed_item": "4 Amended return?",
      "method": "human choice",
      "formula": "Original return only in MVP. Amended = Yes links the original return and enables item 16 (not in MVP).",
      "status": "CONFIRMED",
      "books_source": "user_input",
      "books_policy": "never_fill",
      "citations": [
        "verify.md s4 item 4",
        "workbook 2551Q H.4"
      ]
    },
    {
      "id": "2551Q.H.5",
      "printed_item": "5 Number of sheets attached",
      "method": "human count",
      "formula": "Count the attachment sheets submitted.",
      "status": "CONFIRMED",
      "books_source": "user_input",
      "books_policy": "never_fill",
      "citations": [
        "verify.md s4 item 5"
      ]
    },
    {
      "id": "2551Q.I.6",
      "printed_item": "6 TIN and branch code",
      "method": "profile (derived)",
      "formula": "Derived by BIR from the taxprofile ticket. Books never receives or stores a TIN.",
      "status": "CONFIRMED",
      "books_source": "profile",
      "books_policy": "never_fill",
      "citations": [
        "verify.md s4 item 6 (derived, not fillable)",
        "decision 3"
