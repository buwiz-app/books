    {
      "id": "2551Q.I.13",
      "printed_item": "13 Income-tax rate availed (initial quarter only)",
      "method": "election (locked)",
      "formula": "Election comes from the BIR profile. Forms refuses fills for this box (election lock). Books never fills it. A valid 8% election year blocks all 2551Q values (GATE.8PCT_YEAR_2551Q).",
      "status": "CONFIRMED",
      "books_source": "profile",
      "books_policy": "never_fill",
      "gates": [
        "GATE.8PCT_YEAR_2551Q"
      ],
      "status_detail": "The pin has a 'Not applicable' option (taxRateNA). The printed NA option is UNCONFIRMED (bir.md s2 lists two options).",
      "citations": [
        "verify.md s2 #7, s4 item 13",
        "bir.md s2",
        "RMO 23-2018 (verify.md s2 #72)"
      ]
    },
